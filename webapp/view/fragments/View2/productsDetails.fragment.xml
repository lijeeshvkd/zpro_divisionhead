<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:forms="sap.ui.layout.form"
>
    <ScrollContainer
        width="100%"
        vertical="true"
        focusable="true"
    >
        <Table
            id="idTblProductDetails"
            items="{ProductModel>/}"
        >
            <headerToolbar>
                <Toolbar>
                    <Title text="Products Details" />
                    <!-- Start: Attach001 -->
                    <Link
                        id="idShowAttachments"
                        visible="false"
                        text="Show Attachments"
                        press="onShowAttachmentsLinkPress"
                    />
                    <!-- End: Attach001 -->
                    <ToolbarSpacer />
                
                    <Button text="Generate" icon="sap-icon://cause" press="onGenerate" type="Attention"
                        visible="{= ${oRequestModel>/Status} === 'P' &amp;&amp; (${oRequestModel>/Role} === 'DH' || ${oRequestModel>/Role} === '') }" />
                </Toolbar>
            </headerToolbar>
            <columns>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="8rem">
                    <Label wrapping="true" text="Material Freight Groups" />
                </Column>

                <!-- <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" >
                    <Text text="Product" />
                </Column> -->

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Size" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" >
                    <Text text="Designs" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" 
                    visible="{=${oRequestModel>/Vtweg} === '15' || ${oRequestModel>/Vtweg} === '19' || ${oRequestModel>/Vtweg} === '25' || ${oRequestModel>/Vtweg} === '29'  ? true: false}" >
                    <Text text="ORC(%)" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" 
                    visible="{=${oRequestModel>/Vtweg} === '15' || ${oRequestModel>/Vtweg} === '19' || ${oRequestModel>/Vtweg} === '25' || ${oRequestModel>/Vtweg} === '29'  ? false: true}" >
                    <Text text="ORC(Box)" />
                </Column>

                <!-- <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" >
                    <Text text="Vendor" />
                </Column> -->

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" visible="false" >
                    <Text text="Volume" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" >
                    <Text text="Quality" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Part A/B/L" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Total Volume" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Current Volume" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" 
                    visible="{=${oRequestModel>/Vtweg} === '15' || ${oRequestModel>/Vtweg} === '19' || ${oRequestModel>/Vtweg} === '25' || ${oRequestModel>/Vtweg} === '29'  ? true: false}" >
                    <Text text="Discount(%)" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" 
                    visible="{=${oRequestModel>/Vtweg} === '15' || ${oRequestModel>/Vtweg} === '19' || ${oRequestModel>/Vtweg} === '25' || ${oRequestModel>/Vtweg} === '29'  ? false: true}" >
                    <Text text="Discount(Box)" />
                </Column>

                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center" width="7rem" >
                    <Text text="Net Ex Factory(Sqft)" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Avg Bill Price-L3M_Region" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Last Billed Price-L3M_Dealer" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Min Bill Price-L3M_Region" />
                </Column>

                <Column hAlign="Center">
                    <Text text="Freight" />
                </Column>

                <Column minScreenWidth="Desktop" demandPopin="true"  hAlign="Center" visible="false" >
                    <Text text="Gross Margin" />
                </Column>

                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center" visible="false" >
                    <Text text="Volume(Sqft In Lakhs)" />
                </Column>

                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center" width="10rem">
                    <Text text="Remarks" />
                </Column>

            </columns>

            <items>
                <ColumnListItem vAlign="Middle">
                    <cells>
                        <Text text="{ProductModel>Mfrgr}" />
                        <Text text="{ProductModel>Szcm}" />
                        <Text text="{ProductModel>Design}" />

                        <VBox visible="{=${oRequestModel>/Vtweg} === '15' || ${oRequestModel>/Vtweg} === '19' || ${oRequestModel>/Vtweg} === '25' || ${oRequestModel>/Vtweg} === '29'  ? true: false}">
                            <Input value="{ProductModel>Commboxp}" change="onORCInputChange"
                                visible="{= ${oRequestModel>/Status} === 'P' &amp;&amp; (${oRequestModel>/Role} === 'DH' || ${oRequestModel>/Role} === '') }" />
                            <Text text="{ProductModel>Commboxp}" 
                                visible="{= ${oRequestModel>/Status} !== 'P' || (${oRequestModel>/Role} !== 'DH' &amp;&amp; ${oRequestModel>/Role} !== '') }" />
                        </VBox>
                        
                        <VBox visible="{=${oRequestModel>/Vtweg} === '15' || ${oRequestModel>/Vtweg} === '19' || ${oRequestModel>/Vtweg} === '25' || ${oRequestModel>/Vtweg} === '29'  ? false: true}">
                            <Input value="{ProductModel>Commbox}" change="onORCInputChange"
                                visible="{= ${oRequestModel>/Status} === 'P' &amp;&amp; (${oRequestModel>/Role} === 'DH' || ${oRequestModel>/Role} === '') }" />
                            <Text text="{ProductModel>Commbox}" 
                                visible="{= ${oRequestModel>/Status} !== 'P' || (${oRequestModel>/Role} !== 'DH' &amp;&amp; ${oRequestModel>/Role} !== '') }" />
                        </VBox>

                        <Text visible="false" text="{ProductModel>Volume}" />

                        <Text text="{ProductModel>Zzprodh4}" />
                        <Text text="{ProductModel>Mvgr5}" />
                        <Text text="{ProductModel>Totalvolume}" />
                        <Text text="{ProductModel>CurVolFt}" />
                        <VBox visible="{=${oRequestModel>/Vtweg} === '15' || ${oRequestModel>/Vtweg} === '19' || ${oRequestModel>/Vtweg} === '25' || ${oRequestModel>/Vtweg} === '29'  ? true: false}">
                            <Input value="{ProductModel>Discount}" change="onORCInputChange"
                                visible="{= ${oRequestModel>/Status} === 'P' &amp;&amp; (${oRequestModel>/Role} === 'DH' || ${oRequestModel>/Role} === '') }" />
                            <Text text="{parts:['ProductModel>Discount', 'ProductModel>Discountb'], formatter:'.formatter.getDiscount' }"
                                visible="{= ${oRequestModel>/Status} !== 'P' || (${oRequestModel>/Role} !== 'DH' &amp;&amp; ${oRequestModel>/Role} !== '') }" />
                        </VBox>

                        <VBox visible="{=${oRequestModel>/Vtweg} === '15' || ${oRequestModel>/Vtweg} === '19' || ${oRequestModel>/Vtweg} === '25' || ${oRequestModel>/Vtweg} === '29'  ? false: true}">
                            <Input value="{ProductModel>Discount}" change="onORCInputChange"
                                visible="{= ${oRequestModel>/Status} === 'P' &amp;&amp; (${oRequestModel>/Role} === 'DH' || ${oRequestModel>/Role} === '') }" />
                            <Text text="{parts:['ProductModel>Discount', 'ProductModel>Discountb'], formatter:'.formatter.getDiscount' }"
                                visible="{= ${oRequestModel>/Status} !== 'P' || (${oRequestModel>/Role} !== 'DH' &amp;&amp; ${oRequestModel>/Role} !== '') }" />
                        </VBox>

                        <Text text="{ProductModel>Netexsqft}" />
                        <Text text="{ProductModel>AvgBill}" />
                        <Text text="{ProductModel>LastBill}" />
                        <Text text="{ProductModel>MinBill}" />

                        <Text text="{ProductModel>Frghtsqft}" />

                        <Text visible="false" text="{ProductModel>Grossmarg}" />
                        <Text visible="false" text="{ProductModel>Zvolumepft}" />
                        <TextArea value="{ProductModel>DhRemarkItem}" liveChange="onSbremarkTextAreaLiveChange"
                            editable="{= ${oRequestModel>/Status} === 'P' &amp;&amp; (${oRequestModel>/Role} === 'DH' || ${oRequestModel>/Role} === '') }" />
    
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </ScrollContainer>
</core:FragmentDefinition>
